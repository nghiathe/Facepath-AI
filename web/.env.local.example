# Sao chép thành .env.local. Đã bị .gitignore chặn, không commit.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Tắt model nhận dạng hình mặt (EfficientNet-B4 chạy trong trình duyệt).
# Bỏ trống/không đặt = bật, miễn là có web/public/models/faceshape_b4_fp16.onnx.
# data/README.md yêu cầu thử trên ~50 ảnh webcam người Việt đã gán nhãn tay
# trước khi tin model; đúng dưới ~60% thì đặt "off".
# NEXT_PUBLIC_FACESHAPE_MODEL=off
