# Sao chép file này thành .env rồi điền thông tin thật.
# .env đã bị .gitignore chặn — không bao giờ commit.

# ---- MySQL 8 (mục 3 + 6 CLAUDE.md) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=facepath

# ---- LLM (mốc 5, chưa dùng ở mốc 1) ----
ANTHROPIC_API_KEY=

# ---- CORS: origin của Next.js dev server ----
WEB_ORIGIN=http://localhost:3000
